#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <Adafruit_PN532.h>
#include <WiFi.h>
#include <HTTPClient.h>
#include <ArduinoJson.h>
#include <Update.h>

//  Configuration Wi-Fi
#define WIFI_SSID "Infinix"
#define WIFI_PASSWORD "hot10s2024"

//  Configuration Airtable
const char* AIRTABLE_API_TOKEN = "patojK50mYEJvBdPg.db327840bd2af472b822ddf7e182e13e1b91baf221fdfcf48dc92dc9eaa96094";
const char* AIRTABLE_BASE_ID = "appjQn7q4R8fghqh9";
const char* AIRTABLE_TABLE_NAME = "Cartes";
const char* AIRTABLE_TABLE_NAME2 = "Mises à jour";

//  Définition des broches I2C et PN532
#define SDA_PIN 21
#define SCL_PIN 22

//  Initialisation des modules
Adafruit_PN532 nfc(SDA_PIN, SCL_PIN);
LiquidCrystal_I2C lcd(0x27, 16, 2);

//  Définition des broches LED & Buzzer
#define RED_LED_PIN 12
#define GREEN_LED_PIN 13
#define BUZZER_PIN 15

unsigned long lastOTACheck = 0; // Dernière vérification OTA
const unsigned long OTA_INTERVAL = 30000; // Vérifier toutes les 30 secondes

void setup() {
    Serial.begin(115200);
    Serial.println("Initialisation...");

    //  Connexion au Wi-Fi
    WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
    Serial.print("Connexion au Wi-Fi...");
    while (WiFi.status() != WL_CONNECTED) {
        Serial.print(".");
        delay(500);
    }
    Serial.println("\nWi-Fi connecté !");
    Serial.print("Adresse IP : ");
    Serial.println(WiFi.localIP());

    //  Initialisation des modules
    lcd.init();
    lcd.backlight();
    nfc.begin();
    nfc.SAMConfig();   

    //  Configuration des broches
    pinMode(RED_LED_PIN, OUTPUT);
    pinMode(GREEN_LED_PIN, OUTPUT);
    pinMode(BUZZER_PIN, OUTPUT);

    //  Affichage initial
    afficherMessage("Approchez votre", "dispositif NFC !");
}

//  Afficher un message sur l'écran LCD
void afficherMessage(String ligne1, String ligne2) {
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print(ligne1);
    lcd.setCursor(0, 1);
    lcd.print(ligne2);
}

//  Vérifier l’UID dans Airtable
String verifierUID_Airtable(String uid) {
    HTTPClient http;
    String url = "https://api.airtable.com/v0/" + String(AIRTABLE_BASE_ID) + "/" + String(AIRTABLE_TABLE_NAME) + "?filterByFormula={UID}=\"" + uid + "\"";
    
    http.setReuse(true);
    http.begin(url);
    http.addHeader("Authorization", "Bearer " + String(AIRTABLE_API_TOKEN));

    int httpResponseCode = http.GET();
    String response = "";

    if (httpResponseCode == 200) {
        response = http.getString();
    } else {
        Serial.print("Erreur API: ");
        Serial.println(httpResponseCode);
    }
    http.end();
    return response;
}

//  Mettre à jour le solde dans Airtable
bool mettreAJourSolde(String recordID, int nouveauSolde) {
    HTTPClient http;
    String url = "https://api.airtable.com/v0/" + String(AIRTABLE_BASE_ID) + "/" + String(AIRTABLE_TABLE_NAME) + "/" + recordID;
    String jsonData = "{ \"fields\": { \"Solde\": " + String(nouveauSolde) + " } }";

    http.begin(url);
    http.addHeader("Authorization", "Bearer " + String(AIRTABLE_API_TOKEN));
    http.addHeader("Content-Type", "application/json");

    int httpResponseCode = http.PATCH(jsonData);
    http.end();

    return (httpResponseCode == 200);
}

//  Vérifier l’OTA dans Airtable
String recupererFirmwareAirtable() {
    HTTPClient http;
    String url = "https://api.airtable.com/v0/" + String(AIRTABLE_BASE_ID) + "/" + String(AIRTABLE_TABLE_NAME2) + "?sort[0][field]=Version&sort[0][direction]=desc";

    http.begin(url);
    http.addHeader("Authorization", "Bearer " + String(AIRTABLE_API_TOKEN));

    int httpResponseCode = http.GET();
    String response = "";

    if (httpResponseCode == 200) {
        response = http.getString();
    } else {
        Serial.print("Erreur API: ");
        Serial.println(httpResponseCode);
    }

    http.end();

    DynamicJsonDocument doc(512);
    deserializeJson(doc, response);

    if (doc["records"].size() > 0) {
        return doc["records"][0]["fields"]["URL_Firmware"].as<String>();
    }
    return "";
}

//  Télécharger et Installer la Mise à Jour OTA
void telechargerEtInstallerFirmware(String firmwareURL) {
    HTTPClient http;
    http.begin(firmwareURL);

    int httpCode = http.GET();
    if (httpCode != 200) {
        Serial.println("Erreur téléchargement firmware !");
        return;
    }

    int contentLength = http.getSize();
    if (contentLength <= 0) {
        Serial.println("Firmware invalide !");
        return;
    }

    WiFiClient* stream = http.getStreamPtr();
    if (!Update.begin(contentLength)) {
        Serial.println("Échec initialisation OTA !");
        return;
    }

    Serial.println("Mise à jour en cours...");
    size_t written = Update.writeStream(*stream);
    if (written != contentLength) {
        Serial.println("Échec écriture OTA !");
        return;
    }

    if (!Update.end(true)) {
        Serial.println("Échec finalisation OTA !");
        return;
    }

    Serial.println("Mise à jour réussie ! Redémarrage...");
    ESP.restart();
}

void loop() {
    uint8_t success;
    uint8_t uid[7];
    uint8_t uidLength;
    
    success = nfc.readPassiveTargetID(PN532_MIFARE_ISO14443A, uid, &uidLength);
    if (success) {
        Serial.println("Dispositif NFC détecté !");
        
        String uidString = "";
        for (uint8_t i = 0; i < uidLength; i++) {
            uidString += String(uid[i], HEX);
            if (i < uidLength - 1) uidString += ":";
        }

        Serial.print("UID : ");
        Serial.println(uidString);

        String response = verifierUID_Airtable(uidString);
        DynamicJsonDocument doc(512);
        deserializeJson(doc, response);

        if (doc["records"].size() == 0) {
            Serial.println("UID non trouvé !");
            afficherMessage("Transaction", "rejetee !");
            digitalWrite(RED_LED_PIN, HIGH);
            for (int i = 0; i < 3; i++) {
                tone(BUZZER_PIN, 1000, 200);
                delay(300);
            }
        } else {
            String recordID = doc["records"][0]["id"].as<String>();
            int solde = doc["records"][0]["fields"]["Solde"].as<int>();

            Serial.print("Solde actuel : ");
            Serial.println(solde);

            if (solde > 0) {
                mettreAJourSolde(recordID, solde - 1);
                afficherMessage("Transaction", "approuvee !");
                digitalWrite(GREEN_LED_PIN, HIGH);
                tone(BUZZER_PIN, 1000, 200);
            } else {
                afficherMessage("Transaction", "rejetee !");
                digitalWrite(RED_LED_PIN, HIGH);
                for (int i = 0; i < 3; i++) {
                    tone(BUZZER_PIN, 1000, 200);
                    delay(300);
                }
            }
        }

        delay(1500);
        afficherMessage("Approchez votre", "dispositif NFC !");
        digitalWrite(RED_LED_PIN, LOW);
        digitalWrite(GREEN_LED_PIN, LOW);
    }

    if (millis() - lastOTACheck > OTA_INTERVAL) {
        lastOTACheck = millis();
        String firmwareURL = recupererFirmwareAirtable();
        if (firmwareURL != "") {
            telechargerEtInstallerFirmware(firmwareURL);
        }
    }
}
